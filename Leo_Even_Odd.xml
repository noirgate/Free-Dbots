<block category="trade" type="trade">
  <field name="symbol">R_100</field>
  <field name="trade_type">RISE</field>
  <field name="duration_amount">5</field>
  <field name="duration_type">t</field>
  <field name="amount">10.00</field>
  <field name="currency">USD</field>
  <next>
    <block category="analysis" type="technical_analysis">
      <field name="indicator">SMA</field>
      <field name="timeperiod">5</field>
      <field name="source">close</field>
      <next>
        <block category="analysis" type="technical_analysis">
          <field name="indicator">RSI</field>
          <field name="timeperiod">14</field>
          <next>
            <block category="logic" type="comparison">
              <field name="operator">GT</field>
              <value name="operand1">
                <block category="variables" type="value">
                  <field name="variable_name">SMA</field>
                </block>
              </value>
              <value name="operand2">
                <block category="variables" type="value">
                  <field name="variable_name">RSI</field>
                </block>
              </value>
              <statement name="then">
                <block category="trade" type="trade_again">
                  <field name="trade_type">RISE</field>
                  <field name="amount">20.00</field>
                  <field name="multiplier">2</field>
                </block>
              </statement>
              <statement name="else">
                <block category="trade" type="trade_again">
                  <field name="trade_type">FALL</field>
                  <field name="amount">10.00</field>
                </block>
              </statement>
            </block>
          </next>
        </block>
      </next>
    </block>
  </next>
</block>
